GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Video ingest ---
RTMP_URL=rtmp://127.0.0.1:1935/live/drone
RTSP_URL=
# Seconds to wait for a real RTMP/RTSP source to open.
SOURCE_CONNECT_TIMEOUT_SEC=10.0
# Reconnect backoff after a real source disconnects (exponential, capped).
SOURCE_RECONNECT_DELAY_SEC=2.0
SOURCE_RECONNECT_MAX_DELAY_SEC=30.0
# A live source whose newest frame is older than this is reported "stale".
SOURCE_STALE_AFTER_SEC=3.0
# Frames older than this are never sent to Gemini as current observations.
SOURCE_MAX_FRAME_AGE_SEC=2.0
SOURCE_HEALTH_INTERVAL_SEC=2.0
# Keep driver-side buffering minimal so frames stay current.
SOURCE_LOW_LATENCY=true
# Real-source failures must stay visible. Never enable this for real flights;
# prefer the explicit --allow-synthetic-fallback / --demo-mode CLI flags.
ALLOW_SYNTHETIC_FALLBACK=false

# --- Grafana Loki telemetry (optional) ---
GRAFANA_URL=
GRAFANA_USER=
GRAFANA_API_KEY=

# --- Sampling / serving ---
FRAME_INTERVAL_SEC=0.8
CRITIQUE_COOLDOWN_SEC=5.0
EVENT_LOG_PATH=runs/cinepilot-events.jsonl
HOST=127.0.0.1
PORT=8000
