GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Visual previsualization renderer ---
# "deterministic" (default) renders screen-space animations over the frozen
# source frame and needs no credentials. "google" enables provider-backed AI
# previsualization; it also requires ENABLE_GENERATED_PREVISUALIZATION=true and
# a key. Without both, CinePilot silently keeps the deterministic renderer and
# labels it as deterministic. Deterministic output is never presented as Google
# output.
VISUALIZATION_PROVIDER=deterministic
ENABLE_GENERATED_PREVISUALIZATION=false
# Falls back to GEMINI_API_KEY when empty. Never commit a real key.
GOOGLE_VIDEO_API_KEY=
# "interactions" uses Gemini Omni Flash (multimodal, image-to-video).
# "veo" uses Veo 3.1 image-to-video via models.generate_videos.
GOOGLE_VIDEO_BACKEND=interactions
GOOGLE_VIDEO_MODEL=gemini-omni-1.1-flash
GOOGLE_VIDEO_TIMEOUT_SEC=180.0
GOOGLE_VIDEO_POLL_INTERVAL_SEC=3.0
# Hard ceiling for one generated clip, in bytes (32 MiB).
GOOGLE_VIDEO_MAX_BYTES=33554432
# Providers emit 4, 6, or 8 second clips. A 10-second request is reconciled
# down and the difference is stated explicitly; it is never relabeled.
GOOGLE_VIDEO_DURATION_SEC=8
GOOGLE_VIDEO_RESOLUTION=720p
GOOGLE_VIDEO_ASPECT_RATIO=16:9

# --- Video ingest ---
RTMP_URL=rtmp://127.0.0.1:1935/live/drone
RTSP_URL=
# Seconds to wait for a real RTMP/RTSP source to open.
SOURCE_CONNECT_TIMEOUT_SEC=10.0
# Reconnect backoff after a real source disconnects (exponential, capped).
SOURCE_RECONNECT_DELAY_SEC=2.0
SOURCE_RECONNECT_MAX_DELAY_SEC=30.0
# A live source whose newest frame is older than this is reported "stale".
SOURCE_STALE_AFTER_SEC=3.0
# Frames older than this are never sent to Gemini as current observations.
SOURCE_MAX_FRAME_AGE_SEC=2.0
SOURCE_HEALTH_INTERVAL_SEC=2.0
# Keep driver-side buffering minimal so frames stay current.
SOURCE_LOW_LATENCY=true
# Real-source failures must stay visible. Never enable this for real flights;
# prefer the explicit --allow-synthetic-fallback / --demo-mode CLI flags.
ALLOW_SYNTHETIC_FALLBACK=false

# --- Grafana Loki telemetry (optional) ---
GRAFANA_URL=
GRAFANA_USER=
GRAFANA_API_KEY=

# --- Sampling / serving ---
FRAME_INTERVAL_SEC=0.8
CRITIQUE_COOLDOWN_SEC=5.0
EVENT_LOG_PATH=runs/cinepilot-events.jsonl
HOST=127.0.0.1
PORT=8000
